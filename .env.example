# Plantilla pública — copia este archivo a .env.local y rellena tus valores reales.
# .env.local está en .gitignore y NO se sube a git (a diferencia de este archivo).

# ─── Google Sheets (datos del dashboard) ──────────────────────────────────────
# Cómo obtener:
# 1. https://console.cloud.google.com/ → APIs & Services → Library → "Google Sheets API" → Enable
# 2. Credentials → Create Credentials → API key
# 3. (Recomendado) Restringe la API key a "Google Sheets API"
# 4. Comparte tu sheet como "Cualquiera con el enlace" (Lector)
GOOGLE_SHEETS_API_KEY=tu_api_key_aqui
GOOGLE_SHEETS_SPREADSHEET_ID=el_id_del_sheet_de_la_url
GOOGLE_SHEETS_RANGE=Hoja 1!A:N

# ─── NextAuth (login con Google) ──────────────────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials → Create Credentials
#    → OAuth client ID → Web application
# 2. Authorized redirect URIs:
#    - http://localhost:3000/api/auth/callback/google      (desarrollo)
#    - https://TU-APP.vercel.app/api/auth/callback/google  (producción, agregar luego del deploy)
# 3. Copia Client ID y Client Secret
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret

# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=string_aleatorio_largo_minimo_32_caracteres

# En producción Vercel pone esto automáticamente, en local úsalo así:
NEXTAUTH_URL=http://localhost:3000

# ─── Allowlist de emails ──────────────────────────────────────────────────────
# Lista separada por comas. Solo estos emails podrán entrar.
# Si la dejas vacía, NADIE puede entrar (fail-safe).
ALLOWED_EMAILS=tu_email@ejemplo.com,otro_email@ejemplo.com
